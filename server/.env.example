# Server Port
PORT=3000

# CORS Allowed Origin (use * for all frontends or comma-separated origins)
CORS_ORIGIN=*

# AI Backend Configuration (Points to the running gemini-web2api server)
AI_BACKEND_URL=http://localhost:8081/v1
AI_API_KEY=sk-gemini
AI_MODEL=gemini-3.6-flash

# Optional request timeout in milliseconds
REQUEST_TIMEOUT_MS=60000

# Google AI Studio Gemini API Key (Direct Vision Routing)
GEMINI_API_KEY=

# Google OAuth 2.0 & JWT Authentication
GOOGLE_CLIENT_ID=
JWT_SECRET=

# AI Image Generation Configuration
IMAGE_PROVIDER=huggingface
HF_TOKEN=your_hf_token_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
